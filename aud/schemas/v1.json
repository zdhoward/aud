{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aud:interchange:1",
  "title": "aud interchange document v1",
  "type": "object",
  "required": ["schema_version", "kind", "payload"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["result", "preview", "album_preview", "progress", "list", "inspect", "error"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "result"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/result"}}}},
    {"if": {"properties": {"kind": {"const": "preview"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/preview"}}}},
    {"if": {"properties": {"kind": {"const": "album_preview"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/album_preview"}}}},
    {"if": {"properties": {"kind": {"const": "progress"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/progress"}}}},
    {"if": {"properties": {"kind": {"const": "list"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/list"}}}},
    {"if": {"properties": {"kind": {"const": "inspect"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/inspect"}}}},
    {"if": {"properties": {"kind": {"const": "error"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/error"}}}}
  ],
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}},
    "nullable_string": {"type": ["string", "null"]},
    "file_result": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "target", "operation", "status", "error", "sources", "details"],
      "properties": {
        "source": {"$ref": "#/$defs/nullable_string"}, "target": {"type": "string"},
        "operation": {"type": "string", "minLength": 1},
        "status": {"enum": ["success", "skipped", "failed", "cancelled", "not_run"]},
        "error": {"$ref": "#/$defs/nullable_string"},
        "sources": {"$ref": "#/$defs/strings"}, "details": {"type": "object"}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false, "required": ["succeeded", "items"],
      "properties": {"succeeded": {"type": "boolean"}, "items": {"type": "array", "items": {"$ref": "#/$defs/file_result"}}},
      "allOf": [{"if": {"properties": {"items": {"contains": {"properties": {"status": {"enum": ["failed", "cancelled", "not_run"]}}, "required": ["status"]}}}}, "then": {"properties": {"succeeded": {"const": false}}}, "else": {"properties": {"succeeded": {"const": true}}}}]
    },
    "preview": {
      "type": "object", "additionalProperties": false, "required": ["steps"],
      "properties": {"steps": {"type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["operation", "sources", "targets", "statuses", "settings"],
        "properties": {"operation": {"type": "string"}, "sources": {"$ref": "#/$defs/strings"}, "targets": {"$ref": "#/$defs/strings"}, "statuses": {"type": "array", "items": {"enum": ["ready", "skipped"]}}, "settings": {"type": "object"}}
      }}}
    },
    "album_preview": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "target", "status", "profile", "tracks", "assets", "generated", "manual_review_required"],
      "properties": {
        "operation": {"const": "AlbumPackage"}, "target": {"type": "string"}, "status": {"enum": ["ready", "skipped"]},
        "profile": {"type": "object"}, "tracks": {"type": "array", "items": {"type": "object"}},
        "assets": {"type": "array", "items": {"type": "object", "required": ["source", "member"], "additionalProperties": false, "properties": {"source": {"type": "string"}, "member": {"type": "string"}}}},
        "generated": {"$ref": "#/$defs/strings"}, "manual_review_required": {"$ref": "#/$defs/strings"}
      }
    },
    "progress": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "operation", "completed", "total", "source", "target", "status"],
      "properties": {
        "phase": {"enum": ["start", "finish"]}, "operation": {"type": "string"},
        "completed": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0},
        "source": {"$ref": "#/$defs/nullable_string"}, "target": {"$ref": "#/$defs/nullable_string"},
        "status": {"enum": [null, "success", "skipped", "failed", "cancelled", "not_run", "staged"]}
      }
    },
    "list": {"type": "object", "required": ["files"], "additionalProperties": false, "properties": {"files": {"$ref": "#/$defs/strings"}}},
    "inspect": {"type": "object", "required": ["files"], "additionalProperties": false, "properties": {"files": {"type": "array", "items": {"type": "object", "required": ["path", "codec", "sample_rate", "channels", "bit_depth", "duration", "bit_rate", "tags", "artwork"], "additionalProperties": false, "properties": {
      "path": {"type": "string"}, "codec": {"type": "string"}, "sample_rate": {"type": "integer", "minimum": 1}, "channels": {"type": "integer", "minimum": 1},
      "bit_depth": {"type": ["integer", "null"]}, "duration": {"type": ["number", "null"]}, "bit_rate": {"type": ["integer", "null"]}, "tags": {"type": "object", "additionalProperties": {"type": "string"}}, "artwork": {"type": "array", "items": {"type": "integer"}}
    }}}}},
    "error": {
      "type": "object", "required": ["succeeded", "error", "exit_code", "result"], "additionalProperties": false,
      "properties": {"succeeded": {"const": false}, "error": {"type": "string"}, "exit_code": {"enum": [1, 2, 130]}, "result": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/result"}]}}
    }
  }
}
